<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style/style.css">
    <title>Document</title>
</head>
<body>
    <h1>Editar libro</h1>

<form action="/edit" method="POST">

  <input
    type="text"
    name="title"
    value="<%= book.title %>"
  >

  <input
    type="text"
    name="author"
    value="<%= book.author %>"
  >

    <input
    type="text"
    name="genre"
    value="<%= book.genre %>"
  >

  <input
    type="hidden"
    name="id"
    value="<%= book.id %>"
  >

  <button type="submit">Guardar cambios</button>

</form>
</body>
</html>